{
  "$schema": "https://railway.app/railway.schema.json",
  "web": {
    "build": {
      "builder": "DOCKERFILE",
      "dockerfilePath": "apps/web/Dockerfile"
    },
    "deploy": {
      "numReplicas": 1,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "healthcheckPath": "/api/health",
      "port": 3100
    }
  },
  "indexer": {
    "build": {
      "builder": "DOCKERFILE",
      "dockerfilePath": "apps/indexer/Dockerfile"
    },
    "deploy": {
      "numReplicas": 1,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }
}
