# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ember:ember@localhost:5434/ember
SHADOW_DATABASE_URL=postgresql://ember:ember@localhost:5434/ember_shadow

# ── Cache / Queue ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Auth ───────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=base64-32-bytes
BETTER_AUTH_URL=http://localhost:3100
AUTH_GOOGLE_ID=1072314961401-3mue11lcvldpbituluklh6j9rpl7030d.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=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

# ── Admin seed (used by prisma/seed.ts only) ───────────────────────────────
SEED_SUPER_ADMIN_EMAIL=admin@ember.example
SEED_SUPER_ADMIN_PASSWORD=ChangeMeOnFirstLogin!

# ── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Ember <no-reply@ember.example>"
RESEND_WEBHOOK_SECRET=whsec_...

# ── Wallet UX ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Ember
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ── Stellar / Soroban ──────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
NEXT_PUBLIC_USDC_CONTRACT_ID=C... # testnet USDC contract ID
NEXT_PUBLIC_FACTORY_CONTRACT_ID=C... # deployed factory contract ID

# ── Indexer / Keeper ───────────────────────────────────────────────────────
KEEPER_PRIVATE_KEY=S...
INDEXER_CONFIRMATIONS=12

# ── Storage ────────────────────────────────────────────────────────────────
STORAGE_DRIVER=railway-volume
STORAGE_ROOT=/data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Limits ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=5242880
DEFAULT_VOTING_PERIOD_SECONDS=604800

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=

# ── Railway Deployment ──────────────────────────────────────────────────────
# For Railway, set these via the Railway dashboard (not in this file):
# - DATABASE_URL (Railway PostgreSQL plugin provides this)
# - BETTER_AUTH_SECRET (generate with: openssl rand -base64 32)
# - RESEND_API_KEY
# - NEXT_PUBLIC_USDC_CONTRACT_ID
# - NEXT_PUBLIC_FACTORY_CONTRACT_ID
#
# Railway will auto-detect the railway.json at repo root and use the Dockerfile
# at apps/web/Dockerfile for deployment.
