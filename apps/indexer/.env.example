# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ember:ember@localhost:5434/ember

# ── Cache / Queue ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Stellar / Soroban ───────────────────────────────────────────────────────
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ── Indexer / Keeper ───────────────────────────────────────────────────────
KEEPER_PRIVATE_KEY=S...
INDEXER_CONFIRMATIONS=12
INDEXER_API_KEY=dev-indexer-key
FACTORY_CONTRACT_ID=C... # deployed factory contract ID

# ── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Ember <no-reply@ember.example>"

# ── Web App URL (used in email links) ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info
