{
  "name": "@ember/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "import": "./dist/logger.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./dist/constants.js"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./dist/types/index.js"
    },
    "./abis": {
      "types": "./src/abis/index.ts",
      "import": "./dist/abis/index.js"
    },
    "./contract-errors": {
      "types": "./src/contract-errors.ts",
      "import": "./dist/contract-errors.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pino": "^9.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.27.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.0.0"
  }
}
